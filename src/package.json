{
  "name": "Fllama",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "node start-electron.js",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:mac-x64": "electron-builder --mac --x64",
    "build:mac-arm64": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win",
    "build:win-x64": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux",
    "build:linux-x64": "electron-builder --linux --x64",
    "dist": "electron-builder --publish=never"
  },
  "keywords": [],
  "author": {
    "name": "ArduRadioKot",
    "email": "frogeesoft.team@gmail.com"
  },
  "license": "GPL-2.0",
  "description": "Desktop chat on Electron for Ollama",
  "homepage": "https://github.com/arduradiokot/fllama",
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.arduradiokot.fllama",
    "productName": "Fllama",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "package.json",
      "thoughts.js",
      "settings-store.js",
      "ollama-service.js",
      "providers.js",
      "agent-server.js",
      "project-tools.js",
      "agent-loop.js",
      "opencode-service.js",
      "markdown.js",
      "start-electron.js"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "maintainer": "ArduRadioKot <frogeesoft.team@gmail.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "Fllama",
      "icon": "build/icon.icns"
    }
  }
}
